{
  "id": "opencode",
  "name": "OpenCode",
  "command": "opencode",
  "processes": ["opencode"],
  "logo": { "light": "opencode-light", "dark": "opencode-dark" },
  "resume": ["opencode", "--session", "{session}"],
  "skills_dir": ".agents/skills",
  "screen": {
    "blocked": [
      { "bottom_contains": "[y/n]" },
