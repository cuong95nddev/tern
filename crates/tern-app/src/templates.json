{
  "window": {
    "element": "window",
    "fill": true,
    "children": [
      {
        "when": "menu_bar",
        "element": "menu_bar",
        "layout": "row",
        "align": "center",
        "shrink": 0,
        "children": [{ "slot": "menu_bar" }]
      },
      { "when": "!workspace", "grow": 1, "children": [{ "slot": "welcome" }] },
      { "when": "workspace", "slot": "workspace_tabs" },
      { "when": "workspace", "grow": 1, "children": [{ "slot": "workspace" }] }
    ]
  },
  "workspace": {
    "element": "workspace",
    "fill": true,
    "children": [
      {
        "grow": 1,
        "layout": "row",
        "children": [
          { "slot": "left_strip" },
          {
            "grow": 1,
            "style": { "border_bottom_width": 1, "border": "$border" },
            "split": "row",
            "children": [
              {
                "dock": "left",
                "split": "column",
                "accepts": ["panel"],
                "zones": ["before", "after"],
                "strip": "left",
                "fill": true,
                "fixed": true,
                "size": "$explorer.start_width",
                "min": 140,
                "max": 600,
                "children": [
                  { "part": "explorer", "when": "explorer" },
                  { "part": "scratches", "when": "scratches", "fixed": true, "size": "$scratches.start_height", "min": 90, "max": 800 }
                ]
              },
              { "slot": "center" },
              {
                "dock": "right",
                "split": "column",
                "accepts": ["panel"],
                "zones": ["before", "after"],
                "strip": "right",
                "fill": true,
                "fixed": true,
                "size": "$changes.start_width",
                "min": 180,
                "max": 700,
                "children": [{ "part": "changes", "when": "changes" }]
              }
            ]
          },
          { "slot": "right_strip" }
        ]
      },
      { "use": "status_bar" }
    ]
  },
  "panel_header": {
    "element": "$element",
    "handle": true,
    "layout": "row",
    "align": "center",
    "shrink": 0,
    "children": [
      {
        "grow": 1,
        "layout": "row",
        "style": { "gap": "$element.count_gap" },
        "children": [
          { "truncate": true, "text": "{title}" },
          { "when": "count > 0", "style": { "text": "$element.count_text" }, "text": "{count}" }
        ]
      },
      { "slot": "buttons" }
    ]
  },
  "explorer.header": { "use": "panel_header", "element": "explorer.header" },
  "changes.header": { "use": "panel_header", "element": "changes.header" },
  "scratches.header": { "use": "panel_header", "element": "scratches.header" },
  "status_bar": {
    "element": "workspace.status_bar",
    "layout": "row",
    "align": "center",
    "children": [
      { "text": "{path}" },
      { "text": "{background}" },
      {
        "when": "settings_error",
        "grow": 1,
        "layout": "row",
        "justify": "end",
        "style": { "text": "$workspace.status_bar.error_text" },
        "children": [{ "truncate": true, "text": "Settings: {settings_error}" }]
      }
    ]
  },
  "pane": {
    "frame": "pane",
    "element": "pane",
    "fill": true,
    "states": { "focused": { "border": "$pane.focused_border" } },
    "children": [
      {
        "fill": true,
        "clip": true,
        "style": { "radius": "$pane.radius" },
        "children": [
          {
            "when": "vertical",
            "fill": true,
            "split": "row",
            "children": [
              { "slot": "vertical_tabs", "fixed": true, "size": "$vertical_tabs.start_width", "min": 140, "max": 480 },
              { "use": "pane.body" }
            ]
          },
          {
            "when": "!vertical",
            "fill": true,
            "children": [
              { "slot": "tab_bar" },
              { "grow": 1, "children": [{ "use": "pane.body" }] }
            ]
          }
        ]
      },
      {
        "when": "focus_line",
        "position": { "top": 0, "left": 0, "right": 0 },
        "style": { "height": "$pane.focus_line_height", "background": "$pane.focus_line_color" }
      }
    ]
  },
  "pane.body": {
    "fill": true,
    "children": [
      {
        "element": "pane.body",
        "grow": 1,
        "border_under": true,
        "states": { "focused": { "border": "$pane.body.focused_border" } },
        "children": [
          {
            "fill": true,
            "clip": true,
            "style": { "radius": "$pane.body.radius" },
            "children": [{ "slot": "content" }]
          },
          { "slot": "drop_overlay" },
          {
            "when": "title",
            "position": { "top": "$pane.title.top", "left": "$pane.title.left", "right": "$pane.title.left" },
            "layout": "row",
            "children": [
              {
                "element": "pane.title",
                "truncate": true,
                "text": "{title}",
                "states": { "focused": { "text": "$pane.title.focused_text" } }
              }
            ]
          }
        ]
      }
    ]
  },
  "pane.buttons": {
    "layout": "row",
    "align": "center",
    "style": { "padding_left": 4 },
    "children": [
      {
        "button": "split",
        "element": "pane_tab_bar.button",
        "size": "xsmall",
        "icon": "columns-2",
        "tooltip": "Split Right ({split_key})"
      },
      {
        "when": "panes > 1 && zoomed",
        "button": "zoom",
        "element": "pane_tab_bar.button",
        "size": "xsmall",
        "icon": "minimize-2",
        "selected": true,
        "tooltip": "Restore Panes ({zoom_key})"
      },
      {
        "when": "panes > 1 && !zoomed",
        "button": "zoom",
        "element": "pane_tab_bar.button",
        "size": "xsmall",
        "icon": "maximize-2",
        "tooltip": "Maximize Pane ({zoom_key})"
      },
      {
        "when": "panes > 1",
        "button": "close_pane",
        "element": "pane_tab_bar.button",
        "size": "xsmall",
        "icon": "close",
        "tooltip": "Close Pane (its tabs join the pane before it)"
      },
      {
        "when": "corner",
        "layout": "row",
        "align": "center",
        "style": { "padding_x": 4, "gap": 2 },
        "children": [
          { "button": "pane_layout", "size": "xsmall", "icon": "layout-grid", "selected": "panes > 1", "tooltip": "Pane Layout" }
        ]
      }
    ]
  },
  "pane.new_tab": { "button": "new_tab", "element": "pane_tab_bar.button", "size": "xsmall", "icon": "plus" },
  "pane.empty": {
    "element": "pane.empty",
    "fill": true,
    "justify": "center",
    "clip": true,
    "children": [
      { "layout": "row", "justify": "center", "children": [{ "text": "Drag a tab here, or open one" }] },
      {
        "layout": "wrap",
        "justify": "center",
        "style": { "gap": 8 },
        "children": [
          { "button": "new_claude", "variant": "secondary", "label": "New Claude Tab" },
          { "button": "new_shell", "variant": "secondary", "label": "New Shell Tab" },
          { "button": "close_pane", "label": "Close Pane" }
        ]
      }
    ]
  },
  "pane_tab_bar": {
    "frame": "bar",
    "element": "pane_tab_bar",
    "layout": "row",
    "align": "start",
    "shrink": 0,
    "style": { "border_bottom_width": 0 },
    "states": { "wrap": { "border_bottom_width": "$pane_tab_bar.border_bottom_width" } },
    "children": [
      {
        "when": "!wrap",
        "position": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
        "style": { "border_bottom_width": "$pane_tab_bar.border_bottom_width", "border": "$pane_tab_bar.border" }
      },
      {
        "when": "!wrap",
        "each": "items",
        "frame": "tabs",
        "grow": 1,
        "layout": "row",
        "item": { "use": "pane_tab_bar.item" },
        "children": [{ "use": "pane_tab_bar.end" }]
      },
      {
        "when": "wrap",
        "each": "items",
        "grow": 1,
        "layout": "wrap",
        "item": { "use": "pane_tab_bar.item" },
        "children": [{ "use": "pane_tab_bar.end" }]
      },
      {
        "when": "overflows",
        "layout": "row",
        "align": "center",
        "style": { "height": 32 },
        "children": [{ "button": "more", "size": "xsmall" }]
      },
      {
        "layout": "row",
        "align": "center",
        "style": { "height": 32 },
        "states": { "wrap": { "height": 30 } },
        "children": [{ "use": "pane.buttons" }]
      },
      { "slot": "scrollbar" }
    ]
  },
  "pane_tab_bar.item": {
    "shrink": 0,
    "children": [
      { "when": "group", "use": "pane_tab_bar.chip" },
      { "when": "!group", "use": "pane_tab_bar.tab" }
    ]
  },
  "pane_tab_bar.end": {
    "frame": "end",
    "grow": 1,
    "layout": "row",
    "align": "center",
    "style": { "padding_x": 4, "min_width": 32, "height": 32 },
    "states": { "wrap": { "height": 30 } },
    "children": [{ "use": "pane.new_tab" }]
  },
  "pane_tab_bar.tab": {
    "frame": "tab",
    "element": "pane_tab_bar.tab",
    "layout": "row",
    "align": "center",
    "clip": true,
    "states": {
      "active": { "element": "pane_tab_bar.tab_active" },
      "wrap": { "border_left_width": 0 },
      "hover && !active": { "text": "$pane_tab_bar.tab.hover_text" }
    },
    "children": [
      {
        "layout": "row",
        "align": "center",
        "style": { "padding_left": 8, "gap": 8 },
        "children": [
          { "slot": "icon" },
          { "when": "badge", "text": "{badge}", "style": { "text": "{badge_color}" } }
        ]
      },
      {
        "truncate": true,
        "text": "{label}",
        "style": { "padding_x": 12, "text_transform": "$pane_tab_bar.tab.text_transform" },
        "states": {
          "active": { "text_transform": "$pane_tab_bar.tab_active.text_transform" },
          "preview": { "italic": 1 }
        }
      },
      {
        "layout": "row",
        "align": "center",
        "style": { "padding_right": 4 },
        "children": [
          {
            "button": "close",
            "element": "pane_tab_bar.button",
            "size": "xsmall",
            "icon": "close",
            "tooltip": "Close ({close_key})",
            "style": { "text": "$pane_tab_bar.tab.close_text" },
            "states": { "active": { "text": "$pane_tab_bar.tab_active.close_text" } }
          }
        ]
      },
      {
        "when": "grouped && !active",
        "position": { "left": -1, "right": -1, "bottom": 0 },
        "style": { "height": 2, "background": "{group_color}" }
      },
      {
        "when": "grouped && active",
        "position": { "top": 0, "left": -1, "right": -1, "bottom": 0 },
        "style": {
          "border_top_width": 2,
          "border_left_width": 2,
          "border_right_width": 2,
          "border": "{group_color}",
          "radius_top_left": 8,
          "radius_top_right": 8
        }
      }
    ]
  },
  "pane_tab_bar.chip": {
    "frame": "chip",
    "element": "pane_tab_bar.tab",
    "layout": "row",
    "align": "center",
    "clip": true,
    "states": { "wrap": { "border_left_width": 0 } },
    "children": [
      {
        "layout": "row",
        "align": "center",
        "style": { "padding_x": 12 },
        "states": { "open": { "padding_left": 16 } },
        "children": [
          {
            "when": "!text",
            "style": { "width": 10, "height": 10, "margin_x": 4, "radius": 99, "background": "{group_color}" }
          },
          {
            "when": "text",
            "element": "pane_tab_bar.group",
            "layout": "row",
            "align": "center",
            "truncate": true,
            "text": "{text}",
            "style": { "background": "{group_color}" }
          }
        ]
      },
      {
        "when": "open",
        "position": { "left": 6, "right": -1, "bottom": 0 },
        "style": { "height": 2, "background": "{group_color}", "radius_top_left": 99, "radius_bottom_left": 99 }
      }
    ]
  },
  "vertical_tabs": {
    "frame": "root",
    "element": "vertical_tabs",
    "fill": true,
    "children": [
      {
        "element": "vertical_tabs.header",
        "layout": "row",
        "align": "center",
        "shrink": 0,
        "children": [{ "use": "pane.new_tab" }, { "grow": 1 }, { "use": "pane.buttons" }]
      },
      {
        "frame": "list",
        "element": "vertical_tabs.list",
        "grow": 1,
        "each": "items",
        "item": {
          "shrink": 0,
          "children": [
            { "when": "group", "use": "vertical_tabs.group" },
            { "when": "!group", "use": "vertical_tabs.tab" }
          ]
        },
        "children": [{ "frame": "end", "grow": 1, "style": { "min_height": 40 } }]
      }
    ]
  },
  "vertical_tabs.tab": {
    "frame": "tab",
    "group": "vtab",
    "layout": "row",
    "shrink": 0,
    "style": { "height": "$vertical_tabs.row.height" },
    "states": { "grouped": { "padding_left": "$vertical_tabs.row.group_indent" } },
    "children": [
      {
        "when": "grouped",
        "position": { "top": -1, "bottom": -1, "left": 4 },
        "style": { "width": 3, "background": "{group_color}" },
        "states": {
          "group_first": { "margin_top": 1, "radius_top_left": 99, "radius_top_right": 99 },
          "group_last": { "margin_bottom": 1, "radius_bottom_left": 99, "radius_bottom_right": 99 }
        }
      },
      {
        "element": "vertical_tabs.row",
        "grow": 1,
        "layout": "row",
        "align": "center",
        "states": {
          "active": { "background": "$vertical_tabs.row.selected_background" },
          "hover && !active": { "background": "$vertical_tabs.row.hover_background" }
        },
        "children": [
          { "slot": "icon" },
          { "when": "badge", "text": "{badge}", "style": { "text": "{badge_color}" } },
          { "grow": 1, "truncate": true, "text": "{label}", "states": { "preview": { "italic": 1 } } },
          {
            "shrink": 0,
            "states": { "!active": { "opacity": 0 }, "hover:vtab": { "opacity": 1 } },
            "children": [
              {
                "button": "close",
                "element": "pane_tab_bar.button",
                "size": "xsmall",
                "icon": "close",
                "tooltip": "Close ({close_key})"
              }
            ]
          }
        ]
      }
    ]
  },
  "vertical_tabs.group": {
    "frame": "group",
    "element": "vertical_tabs.group",
    "layout": "row",
    "align": "center",
    "shrink": 0,
    "style": { "background": "{group_color}" },
    "states": { "hover": { "opacity": 0.9 } },
    "children": [
      { "grow": 1, "truncate": true, "text": "{name}" },
      { "when": "collapsed", "shrink": 0, "style": { "font_size": "0.75rem" }, "text": "{count}" },
      {
        "when": "collapsed",
        "icon": "chevron-down",
        "style": { "width": 14, "height": 14, "text": "$vertical_tabs.group.text" }
      },
      {
        "when": "!collapsed",
        "icon": "chevron-up",
        "style": { "width": 14, "height": 14, "text": "$vertical_tabs.group.text" }
      }
    ]
  },
  "workspace_tabs": {
    "frame": "bar",
    "element": "workspace_tabs",
    "layout": "row",
    "align": "center",
    "shrink": 0,
    "children": [
      {
        "position": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
        "style": { "border_bottom_width": 1, "border": "$border" }
      },
      {
        "each": "items",
        "frame": "tabs",
        "grow": 1,
        "layout": "row",
        "align": "center",
        "item": { "use": "workspace_tabs.tab" },
        "children": [
          {
            "frame": "end",
            "layout": "row",
            "align": "center",
            "shrink": 0,
            "style": { "padding_left": 4, "height": "$workspace_tabs.tab.height" },
            "children": [
              {
                "button": "open",
                "element": "workspace_tabs.button",
                "size": "xsmall",
                "icon": "folder-plus",
                "tooltip": "Open Workspace… ({open_key})"
              }
            ]
          },
          { "frame": "end", "grow": 1, "style": { "height": "$workspace_tabs.tab.height" } },
          {
            "frame": "end",
            "layout": "row",
            "align": "center",
            "shrink": 0,
            "style": { "padding_right": 4, "height": "$workspace_tabs.tab.height" },
            "children": [
              {
                "button": "agent_monitor",
                "element": "workspace_tabs.button",
                "size": "xsmall",
                "icon": "bot",
                "selected": "monitor",
                "tooltip": "Agent Monitor"
              },
              {
                "when": "update",
                "button": "update",
                "element": "workspace_tabs.button",
                "size": "xsmall",
                "icon": "circle-arrow-down",
                "label": "{update}",
                "loading": "installing",
                "tooltip": "A new version of Tern is available"
              }
            ]
          }
        ]
      },
      { "shrink": 0, "style": { "width": 4 } }
    ]
  },
  "workspace_tabs.tab": {
    "frame": "tab",
    "element": "workspace_tabs.tab",
    "layout": "row",
    "align": "center",
    "shrink": 0,
    "clip": true,
    "states": {
      "active": { "element": "workspace_tabs.tab_active" },
      "hover && !active": { "text": "$workspace_tabs.tab.hover_text" }
    },
    "children": [
      {
        "layout": "row",
        "align": "center",
        "style": { "padding_left": 8, "gap": 4, "text": "$workspace_tabs.tab.icon_text" },
        "states": { "active": { "text": "$workspace_tabs.tab_active.icon_text" } },
        "children": [
          { "icon": "folder-open", "style": { "width": 12, "height": 12 } },
          { "when": "busy", "text": "●", "style": { "text": "$warning" } }
        ]
      },
      {
        "truncate": true,
        "text": "{name}",
        "style": { "padding_x": 12, "text_transform": "$workspace_tabs.tab.text_transform" },
        "states": { "active": { "text_transform": "$workspace_tabs.tab_active.text_transform" } }
      },
      {
        "layout": "row",
        "align": "center",
        "style": { "padding_right": 4 },
        "children": [
          {
            "button": "close",
            "element": "workspace_tabs.button",
            "size": "xsmall",
            "icon": "close",
            "tooltip": "Close Workspace ({close_key})",
            "style": { "text": "$workspace_tabs.tab.close_text" },
            "states": { "active": { "text": "$workspace_tabs.tab_active.close_text" } }
          }
        ]
      }
    ]
  },
  "welcome": {
    "fill": true,
    "align": "center",
    "justify": "center",
    "style": {
      "background_image": "$welcome.background_image",
      "background_image_fit": "$welcome.background_image_fit",
      "background_image_opacity": "$welcome.background_image_opacity"
    },
    "children": [
      {
        "element": "welcome",
        "style": { "background_image": "" },
        "children": [
          {
            "style": { "gap": 4 },
            "children": [
              { "element": "welcome.title", "text": "Tern" },
              { "element": "welcome.subtitle", "text": "Terminals, files and git changes of one folder per workspace." }
            ]
          },
          {
            "layout": "row",
            "style": { "gap": 8 },
            "children": [
              { "button": "open", "variant": "primary", "size": "medium", "icon": "folder-plus", "label": "Open Workspace…" }
            ]
          },
          {
            "when": "recents > 0",
            "style": { "gap": 4 },
            "children": [
              { "text": "Recent", "style": { "font_size": "$text_sm", "text": "$welcome.keys.detail_text" } },
              { "each": "recent", "style": { "gap": 2 }, "item": { "use": "welcome.recent" } }
            ]
          },
          {
            "element": "welcome.keys",
            "children": [
              {
                "layout": "row",
                "justify": "between",
                "style": { "gap": 32 },
                "children": [{ "text": "Open workspace", "style": { "text": "$welcome.keys.detail_text" } }, { "text": "{open_key}" }]
              },
              {
                "layout": "row",
                "justify": "between",
                "style": { "gap": 32 },
                "children": [{ "text": "New window", "style": { "text": "$welcome.keys.detail_text" } }, { "text": "{new_window_key}" }]
              },
              {
                "layout": "row",
                "justify": "between",
                "style": { "gap": 32 },
                "children": [{ "text": "Close workspace", "style": { "text": "$welcome.keys.detail_text" } }, { "text": "{close_key}" }]
              },
              {
                "layout": "row",
                "justify": "between",
                "style": { "gap": 32 },
                "children": [{ "text": "Switch workspace", "style": { "text": "$welcome.keys.detail_text" } }, { "text": "{switch_key}" }]
              }
            ]
          }
        ]
      }
    ]
  },
  "welcome.recent": {
    "frame": "recent",
    "element": "welcome.recent",
    "layout": "row",
    "align": "center",
    "states": { "hover": { "background": "$welcome.recent.hover_background" } },
    "children": [
      { "icon": "folder-open", "style": { "width": 14, "height": 14, "text": "$welcome.recent.detail_text" } },
      { "text": "{name}" },
      {
        "truncate": true,
        "text": "{path}",
        "style": { "font_size": "$welcome.recent.detail_font_size", "text": "$welcome.recent.detail_text" }
      }
    ]
  },
  "settings": {
    "element": "settings",
    "fill": true,
    "layout": "row",
    "children": [
      { "element": "settings.nav", "children": [{ "each": "sections", "item": { "use": "settings.nav_item" } }] },
      {
        "frame": "page",
        "grow": 1,
        "children": [
          {
            "element": "settings.page",
            "children": [
              {
                "style": { "gap": 4 },
                "children": [
                  { "element": "settings.title", "text": "{title}" },
                  { "element": "settings.subtitle", "text": "{subtitle}" }
                ]
              },
              { "element": "settings.group", "children": [{ "each": "rows", "item": { "use": "settings.row" } }] },
              { "slot": "extra" }
            ]
          }
        ]
      }
    ]
  },
  "settings.nav_item": {
    "frame": "section",
    "element": "settings.nav_item",
    "layout": "row",
    "align": "center",
    "states": {
      "hover && !active": { "background": "$settings.nav_item.hover_background" },
      "active": { "element": "settings.nav_item_active" }
    },
    "children": [{ "icon": "{icon}", "style": { "width": 14, "height": 14 } }, { "text": "{label}" }]
  },
  "settings.row": {
    "element": "settings.row",
    "layout": "row",
    "align": "center",
    "states": { "index > 0": { "border_top_width": "$settings.row.divider_width" } },
    "children": [
      {
        "grow": 1,
        "shrink": 1,
        "style": { "gap": 2 },
        "children": [
          { "element": "settings.row.title", "text": "{title}" },
          { "when": "description", "element": "settings.row.description", "text": "{description}" },
          { "when": "problem", "element": "settings.row.problem", "text": "{problem}" }
        ]
      },
      {
        "layout": "row",
        "align": "center",
        "shrink": 0,
        "style": { "gap": 6 },
        "children": [
          { "when": "stepper && changed", "button": "reset", "size": "xsmall", "icon": "undo-2", "tooltip": "Back to the default ({default})" },
          { "when": "stepper", "button": "dec", "variant": "outline", "size": "xsmall", "icon": "minus", "disabled": "at_min" },
          { "when": "value", "element": "settings.row.value", "text": "{value}" },
          { "when": "stepper", "button": "inc", "variant": "outline", "size": "xsmall", "icon": "plus", "disabled": "at_max" },
          { "when": "action", "button": "action", "variant": "outline", "size": "small", "label": "{action}", "loading": "busy", "disabled": "busy" },
          {
            "when": "switch",
            "frame": "switch",
            "element": "settings.switch",
            "layout": "row",
            "align": "center",
            "states": { "on": { "element": "settings.switch_on" }, "busy": { "opacity": 0.5 } },
            "children": [{ "element": "settings.switch.knob" }]
          }
        ]
      }
    ]
  },
  "settings.remote": {
    "element": "settings.group",
    "children": [
      {
        "element": "settings.row",
        "layout": "row",
        "align": "start",
        "children": [
          { "slot": "qr" },
          {
            "grow": 1,
            "shrink": 1,
            "style": { "gap": 8 },
            "children": [
              { "element": "settings.row.title", "text": "Pairing link" },
              {
                "element": "settings.row.description",
                "text": "Scan the code with your phone's camera, or open the link on another computer. Anyone with the link can use your terminals: keep it secret."
              },
              { "element": "settings.link", "truncate": true, "text": "{link}" },
              { "when": "dns_link", "element": "settings.row.description", "truncate": true, "text": "With MagicDNS: {dns_link}" },
              {
                "layout": "row",
                "style": { "gap": 8 },
                "children": [
                  { "button": "copy", "variant": "outline", "size": "small", "icon": "{copy_icon}", "label": "{copy_label}" },
                  {
                    "button": "new_link",
                    "variant": "outline",
                    "size": "small",
                    "icon": "refresh-cw",
                    "label": "New Link",
                    "tooltip": "Make a new link; the old one stops working",
                    "loading": "busy",
                    "disabled": "busy"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
